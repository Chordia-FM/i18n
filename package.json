{
  "name": "@chordia/i18n",
  "version": "0.1.0",
  "description": "Shared localization catalogs (ICU MessageFormat) for the Chordia ecosystem. Single source of truth, synced with Crowdin.",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "types": "./index.ts",
  "exports": {
    ".": "./index.ts",
    "./locales/*": "./locales/*"
  },
  "files": [
    "index.ts",
    "locales"
  ],
  "scripts": {
    "crowdin:lint": "crowdin config lint",
    "crowdin:push": "crowdin upload sources",
    "crowdin:push-drafts": "crowdin upload translations --no-auto-approve-imported --no-import-eq-suggestions",
    "crowdin:pull": "crowdin download",
    "crowdin:status": "crowdin status translation",
    "check": "node scripts/check-catalogs.mjs"
  },
  "devDependencies": {
    "@crowdin/cli": "^4.15.0"
  }
}
