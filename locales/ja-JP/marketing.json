	"pillars": {
		"liveRooms": {
			"body": "チャット、投票、交代制DJのある同期リスニングパーティー。自分が所有する曲は自分のコピーで再生され、残りはライブラリが中継します。",
			"title": "ライブリスニングルーム"
		},
		"ownIt": {
			"body": "ライブラリは自宅のNASやRaspberry Piにも、クラウドサーバーにも置けます。どちらでも音楽はあなたのものです。ビットパーフェクト（FLAC、ALAC、WAV、Dolby Atmos）でデバイスに直接ストリーミングされ、Chordiaがあなたのオーディオを保存・中継することはありません。",
			"title": "所有して、どこでもホスト"
		},
		"selectiveSharing": {
			"body": "音楽を「ハイファイアーカイブ」「家族コレクション」のような別々のライブラリに整理し、それぞれを選んだフレンドとだけ共有できます。",
			"title": "選択的な共有"
		},
		"wrapped": {
			"body": "すべての再生はグローバルアカウントにスクロブルされ、永久に保存されます。週間・月間・年間のインサイトは、サーバーを移行しても失われません。",
			"title": "一生もののWrapped"
